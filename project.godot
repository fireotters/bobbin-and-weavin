;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/array_color_tint=100.0
resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=false
resources_spreadsheet_view/fold_docks=true
resources_spreadsheet_view/resource_cell_label_mode=1
resources_spreadsheet_view/freeze_first_column=true

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Bobbin' & Weavin'"
config/version="1.0"
run/main_scene="uid://olxmp2tfg8yc"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/art/ico/windows.ico"
config/windows_native_icon="res://assets/art/ico/windows.ico"

[autoload]

BeehaveGlobalMetrics="*uid://dcwrnc1shascs"
BeehaveGlobalDebugger="*uid://b1ah6smymc06j"
AudioPlayer="*res://scenes/global/audio_player.gd"
PlayerVariables="*res://scenes/global/player_variables.gd"
SignalBus="*res://scenes/global/signal_bus.gd"
ConfigfileHandler="*res://scenes/global/configfile_handler.gd"

[display]

window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/beehave/plugin.cfg", "res://addons/resources_spreadsheet_view/plugin.cfg")

